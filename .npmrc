# Hardening cadena de suministro de paquetes
# (ataque a TanStack del 12-13/05/2026 y su propagación a Mistral/OpenSearch/UiPath/PyPI)
#
# pnpm 11 NO ejecuta scripts de instalación por default. Las excepciones de
# paquetes legítimos que necesitan postinstall (sharp, unrs-resolver, etc.) viven
# en package.json -> "pnpm": { "onlyBuiltDependencies": [...] }.
#
# minimum-release-age=1440 — bloquea instalación de versiones publicadas hace
# menos de 24 horas (1440 min). Defensa contra paquetes recién subidos con
# código malicioso, que es la ventana típica de detección antes de que la
# comunidad lo flaguee.
minimum-release-age=1440
