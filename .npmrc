# Hardening cadena de suministro npm — bloquea scripts de instalación
# (vector del ataque a TanStack del 12-13/05/2026 y su propagación a Mistral/OpenSearch/UiPath/PyPI)
# Si algún paquete legítimo necesita postinstall y rompe el build:
#   https://docs.npmjs.com/cli/v10/using-npm/config#ignore-scripts
ignore-scripts=true
